{
  "ConnectionStrings": {
    "Azurite": "UseDevelopmentStorage=true;"
  },
  "Shuttle": {
    "Hopper": {
      "Inbox": {
        "WorkTransportUri": "azuresq://hopper-samples/hopper-server-work",
        "DeferredTransportUri": "azuresq://hopper-samples/hopper-server-deferred",
        "ErrorTransportUri": "azuresq://hopper-samples/hopper-error",
        "DurationToSleepWhenIdle": [
          "00:00:00.250"
        ]
      },
      "AdditionalInboxes": {
        "priority": {
          "WorkTransportUri": "azuresq://hopper-samples/hopper-server-priority-work",
          "ThreadCount": 1
        },
        "stream": {
          "WorkTransportUri": "kafka://local/stream-consumer-work",
          "ThreadCount": 1
        }
      }
    }
  }
}